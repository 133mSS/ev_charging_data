# Copy the values into your local .env (never commit the real .env).
SNOWFLAKE_ACCOUNT=<organization-account-or-account-locator>
SNOWFLAKE_USER=<snowflake-user>
SNOWFLAKE_PASSWORD=<password>
# For managed Google OIDC sign-in, use OAUTH_AUTHORIZATION_CODE.
# For Google Workspace SAML or other SAML IdPs, use externalbrowser.
# In either browser-based SSO mode, SNOWFLAKE_PASSWORD is not required.
# SNOWFLAKE_AUTHENTICATOR=OAUTH_AUTHORIZATION_CODE
SNOWFLAKE_ROLE=<role-with-create-database-and-warehouse-privileges>
SNOWFLAKE_WAREHOUSE=JPL_ETL_WH
