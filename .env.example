# JPL dataset configuration
ACN_SITE_ID=jpl
ACN_API_TOKEN=

# Git clone of tongxin-li/ACN-Data-Static (sparse checkout of JPL folder)
ACN_STATIC_REPO=./external/ACN-Data-Static
